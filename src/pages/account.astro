---
import Layout from '../layouts/Layout.astro';
const user = Astro.locals.user!;
---

<Layout title="Mi perfil" active="account">
  <div class="page-heading">
    <div>
      <p class="eyebrow">TU CUENTA</p>
      <h1>{user.name}</h1>
      <p>{user.email}</p>
    </div>
  </div>
  <section class="panel account-panel">
    <h2>Cambiar contraseña</h2>
    <p class="muted">Al cambiarla se cerrarán todas tus sesiones.</p>
    <form action="/api/command" method="post" class="form-stack">
      <input type="hidden" name="action" value="password.change" />
      <label>
        Contraseña actual
        <input
          type="password"
          name="current"
          required
          autocomplete="current-password"
          maxlength="128"
        />
      </label>
      <label>
        Nueva contraseña
        <input
          type="password"
          name="password"
          required
          minlength="12"
          maxlength="128"
          autocomplete="new-password"
        />
        <small>Al menos 12 caracteres.</small>
      </label>
      <button class="button primary" type="submit">
        Actualizar contraseña
      </button>
    </form>
    <form action="/api/auth" method="post" class="form-stack">
      <input type="hidden" name="action" value="logout" />
      <button class="button" type="submit">
        Cerrar sesión
      </button>
    </form>
  </section>
</Layout>
