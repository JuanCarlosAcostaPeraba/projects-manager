---
import Layout from '../../layouts/Layout.astro';
import TaskFields from '../../components/TaskFields.astro';
import KanbanBoard from '../../components/KanbanBoard.astro';
import GanttView from '../../components/GanttView.astro';
import DeleteButton from '../../components/DeleteButton.astro';
import Icon from '../../components/Icon.astro';
import {
  projectData,
  statuses,
  priorities,
  dateLabel,
} from '../../server/data';
import { canWrite, AppError } from '../../server/permissions';
import { z } from 'zod';
if (!z.uuid().safeParse(Astro.params.id).success)
  return Astro.redirect('/?error=Proyecto%20no%20encontrado');
let data;
try {
  data = await projectData(Astro.locals.user!, Astro.params.id!);
} catch (error) {
  if (error instanceof AppError)
    return Astro.redirect(`/?error=${encodeURIComponent(error.message)}`);
  throw error;
}
const { project, tasks, members } = data;
const writable = canWrite(project.access) && !project.archived;
const view = ['list', 'gantt'].includes(
  Astro.url.searchParams.get('view') || '',
)
  ? Astro.url.searchParams.get('view')!
  : 'board';
const query = Astro.url.searchParams.get('q') || '';
const assignee = Astro.url.searchParams.get('assignee') || '';
const status = Astro.url.searchParams.get('status') || '';
const priority = Astro.url.searchParams.get('priority') || '';
const visible = tasks.filter(
  (t) =>
    `${project.key}-${t.number} ${t.title} ${t.description}`
      .toLowerCase()
      .includes(query.toLowerCase()) &&
    (!assignee ||
      (assignee === 'unassigned'
        ? !t.assignee_id
        : t.assignee_id === assignee)) &&
    (!status || status === t.status) &&
    (!priority || priority === t.priority),
);
function viewLink(value: string) {
  const params = new URLSearchParams(Astro.url.search);
  params.set('view', value);
  return '?' + params.toString();
}
---

<Layout title={project.name}>
  <a class="back-link" href="/">
    ← Todos los proyectos
  </a>
  <div class="page-heading">
    <div>
      <p class="eyebrow">
        {project.area_name}
        <span class="separator">/</span>
        {project.key}
      </p>
      <h1>{project.name}</h1>
      <p>
        {project.description ||
          'Organiza el trabajo y comparte el progreso con tu equipo.'}
      </p>
    </div>
    <div class="action-row">
      {project.access === 'manager' && (
        <DeleteButton
          kind="project"
          id={project.id}
          title={project.name}
          description={`Este proyecto, sus ${tasks.length} tareas y sus comentarios se moverán a la papelera. Podrás restaurarlos juntos.`}
          iconOnly
        />
      )}
      {writable && (
        <button class="button primary" data-open-dialog="new-task">
          <Icon name="plus" />
          Nueva tarea
        </button>
      )}
    </div>
  </div>
  <div class="project-meta">
    <span class="badge">{tasks.length} tareas</span>
    <span>
      ☑{' '}
      <span data-completed-count>
        {tasks.filter((t) => t.status === 'done').length}
      </span>{' '}
      completadas
    </span>
    {!writable && <span class="badge">Acceso de lectura</span>}
  </div>
  <div class="board-toolbar">
    <div class="tabs">
      <a
        class:list={['tab', { active: view === 'board' }]}
        href={viewLink('board')}
      >
        ▦ Tablero
      </a>
      <a
        class:list={['tab', { active: view === 'list' }]}
        href={viewLink('list')}
      >
        ☰ Lista
      </a>
      <a
        class:list={['tab', { active: view === 'gantt' }]}
        href={viewLink('gantt')}
      >
        <Icon name="calendar" />
        Gantt
      </a>
    </div>
    <span class="view-result-count">
      <span data-visible-count>{visible.length}</span> de {tasks.length} tareas
    </span>
  </div>
  <form class="filters project-filters" method="get">
    <input type="hidden" name="view" value={view} />
    <input
      type="search"
      name="q"
      value={query}
      placeholder="Buscar título, clave o descripción…"
      aria-label="Buscar tareas"
    />
    <select name="assignee" aria-label="Filtrar por responsable">
      <option value="">Todos los responsables</option>
      <option value="unassigned" selected={assignee === 'unassigned'}>
        Sin asignar
      </option>
      {members.map((m) => (
        <option value={m.id} selected={m.id === assignee}>
          {m.name}
        </option>
      ))}
    </select>
    <select name="status" aria-label="Filtrar por estado">
      <option value="">Todos los estados</option>
      {Object.entries(statuses).map(([value, label]) => (
        <option value={value} selected={status === value}>
          {label}
        </option>
      ))}
    </select>
    <select name="priority" aria-label="Filtrar por prioridad">
      <option value="">Todas las prioridades</option>
      {Object.entries(priorities).map(([value, label]) => (
        <option value={value} selected={priority === value}>
          {label}
        </option>
      ))}
    </select>
    <button type="submit" class="button">
      <Icon name="filter" />
      Filtrar
    </button>
    {(query || assignee || status || priority) && (
      <a class="button" href={`?view=${view}`}>
        Limpiar
      </a>
    )}
  </form>
  {view === 'board' ? (
    <KanbanBoard project={project} tasks={visible} writable={writable} />
  ) : view === 'gantt' ? (
    <GanttView project={project} tasks={visible} />
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Tarea</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Responsable</th>
            <th>Inicio</th>
            <th>Fecha límite</th>
            {writable && <th>Acciones</th>}
          </tr>
        </thead>
        <tbody>
          {visible.map((t) => (
            <tr>
              <td>
                <a href={`/tasks/${t.id}`}>
                  <span class="mono">
                    {project.key}-{t.number}
                  </span>
                  {t.title}
                </a>
              </td>
              <td>
                <span class={`status-dot ${t.status}`}></span>
                {statuses[t.status as keyof typeof statuses]}
              </td>
              <td>
                <span class={`priority ${t.priority}`}>
                  {priorities[t.priority as keyof typeof priorities]}
                </span>
              </td>
              <td>{t.assignee_name || 'Sin asignar'}</td>
              <td>{dateLabel(t.start_date)}</td>
              <td>{dateLabel(t.due_date)}</td>
              {writable && (
                <td>
                  <DeleteButton
                    kind="task"
                    id={t.id}
                    title={t.title}
                    version={t.version}
                    iconOnly
                  />
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
      {!visible.length && (
        <p class="empty">No hay tareas que coincidan con estos filtros.</p>
      )}
    </div>
  )}
  {writable && (
    <dialog id="new-task">
      <div class="dialog-heading">
        <h2>
          Nueva tarea <span class="mono">{project.key}</span>
        </h2>
        <button
          type="button"
          class="icon-button"
          data-close-dialog
          aria-label="Cerrar"
        >
          ✕
        </button>
      </div>
      <form class="form-stack" action="/api/command" method="post">
        <input type="hidden" name="action" value="task.create" />
        <input type="hidden" name="project_id" value={project.id} />
        <TaskFields members={members} />
        <button type="submit" class="button primary">
          Crear tarea
        </button>
      </form>
    </dialog>
  )}
</Layout>
