---
import '@/styles/global.css';
import { initials } from '../server/data';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import BrandLogo from '../components/BrandLogo.astro';
import DeleteDialog from '../components/DeleteDialog.astro';
import themeScript from '../scripts/theme.js?raw';
interface Props {
  title?: string;
  active?: string;
}
const { title = 'Proyectos', active = 'projects' } = Astro.props;
const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Organiza tus proyectos y tareas con tu equipo."
    />
    <title>{title} · Projects Manager</title>
  </head>
  <body>
    {user ? (
      <div class="app-shell">
        <aside class="sidebar">
          <a class="brand" href="/">
            <BrandLogo />
            <span>
              Projects<span class="brand-sub">MANAGER</span>
            </span>
          </a>
          <div class="workspace">
            <span class="workspace-icon">E</span>
            <div>
              Espacio de trabajo<small>Tu equipo, conectado</small>
            </div>
          </div>
          <p class="nav-label">ORGANIZACIÓN</p>
          <nav aria-label="Navegación principal">
            <a
              class:list={['nav-item', { selected: active === 'projects' }]}
              href="/"
            >
              <span aria-hidden="true">▦</span> Proyectos
            </a>
            <a
              class:list={['nav-item', { selected: active === 'tasks' }]}
              href="/my-tasks"
            >
              <span aria-hidden="true">☑</span> Mis tareas
            </a>
            <a
              class:list={['nav-item', { selected: active === 'areas' }]}
              href="/areas"
            >
              <span aria-hidden="true">◫</span> Áreas y equipo
            </a>
            {user.role === 'admin' && (
              <a
                class:list={['nav-item', { selected: active === 'admin' }]}
                href="/admin"
              >
                <span aria-hidden="true">⚙</span> Administración
              </a>
            )}
            <a
              class:list={['nav-item', { selected: active === 'trash' }]}
              href="/trash"
            >
              <span aria-hidden="true">♲</span> Papelera
            </a>
            <a
              class:list={[
                'nav-item',
                'mobile-account',
                { selected: active === 'account' },
              ]}
              href="/account"
            >
              Mi perfil
            </a>
          </nav>
          <div class="sidebar-bottom">
            <div class="environment">
              <span class="live-dot"></span> Entorno de pruebas
            </div>
            <a class="profile" href="/account">
              <span class="avatar">{initials(user.name)}</span>
              <div>
                {user.name}
                <small>
                  {user.role === 'admin'
                    ? 'Administrador'
                    : 'Miembro del equipo'}
                </small>
              </div>
            </a>
            <form action="/api/auth" method="post">
              <input type="hidden" name="action" value="logout" />
              <button class="logout" type="submit">
                Cerrar sesión ↗
              </button>
            </form>
          </div>
        </aside>
        <div class="main-shell">
          <header class="topbar">
            <span class="min-w-0 truncate">
              Espacio de trabajo <span class="separator">/</span>{' '}
              <strong>{title}</strong>
            </span>
            <div class="flex shrink-0 items-center gap-4">
              <span class="topbar-note">Un lugar para avanzar juntos</span>
              <ThemeSwitcher />
            </div>
          </header>
          <main id="main-content">
            {notice && (
              <div class="success" role="status">
                {notice}
              </div>
            )}
            {error && (
              <div class="alert" role="alert">
                {error}
              </div>
            )}
            <slot />
          </main>
        </div>
      </div>
    ) : (
      <main class="auth-shell">
        <div class="absolute right-4 top-4 sm:right-6 sm:top-6">
          <ThemeSwitcher />
        </div>
        {error && (
          <div class="alert" role="alert">
            {error}
          </div>
        )}
        <slot />
      </main>
    )}
    {user && <DeleteDialog />}
    <script>
      import '../scripts/delete-controls';
      document
        .querySelectorAll<HTMLButtonElement>('[data-open-dialog]')
        .forEach((button) =>
          button.addEventListener('click', () => {
            const dialog = document.getElementById(
              button.dataset.openDialog!,
            ) as HTMLDialogElement;
            if (dialog?.id === 'new-task')
              dialog.querySelector<HTMLSelectElement>(
                'select[name=status]',
              )!.value = button.dataset.taskStatus || 'backlog';
            dialog?.showModal();
          }),
        );
      document
        .querySelectorAll<HTMLButtonElement>('[data-close-dialog]')
        .forEach((button) =>
          button.addEventListener('click', () =>
            button.closest('dialog')?.close(),
          ),
        );
      document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) =>
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        }),
      );
    </script>
  </body>
</html>
